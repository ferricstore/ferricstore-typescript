{
  "name": "@ferricstore/ferricstore",
  "version": "0.13.0",
  "description": "TypeScript SDK for FerricStore and FerricFlow",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "author": "FerricStore",
  "homepage": "https://github.com/ferricstore/ferricstore-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferricstore/ferricstore-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/ferricstore/ferricstore-typescript/issues"
  },
  "keywords": [
    "durable-execution",
    "ferricflow",
    "ferricstore",
    "queue",
    "redis",
    "state-machine",
    "workflow"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "ferricstore": {
    "minimumServerVersion": "0.11.4",
    "nativeProtocolVersion": 1
  },
  "packageManager": "npm@11.6.2",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./langgraph": {
      "import": {
        "types": "./dist/langgraph.d.ts",
        "default": "./dist/langgraph.js"
      },
      "require": {
        "types": "./dist/langgraph.d.cts",
        "default": "./dist/langgraph.cjs"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/openai-agents.d.ts",
        "default": "./dist/openai-agents.js"
      },
      "require": {
        "types": "./dist/openai-agents.d.cts",
        "default": "./dist/openai-agents.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/langgraph.ts src/openai-agents.ts --format esm,cjs --dts --sourcemap --clean --splitting false",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:exports && npm run docs:check",
    "docs": "typedoc --logLevel Warn && typedoc --options typedoc.agent.json --logLevel Warn",
    "docs:check": "npm run docs && node scripts/check-generated-docs.mjs",
    "integration:down": "docker compose down -v",
    "integration:up": "docker compose up -d ferricstore && node scripts/wait-for-ferricstore.mjs",
    "lint": "eslint .",
    "pack:dry-run": "npm pack --dry-run",
    "test": "vitest run tests/*.test.ts",
    "test:exports": "node scripts/check-package-exports.mjs",
    "test:integration": "vitest run tests/integration",
    "test:integration:http": "scripts/run-http-integration.sh",
    "test:integration:isolated": "node scripts/run-isolated-integration.mjs",
    "test:integration:deployment": "vitest run tests/integration/deployment.test.ts",
    "typecheck": "tsc --noEmit",
    "bench:kv": "node benchmarks/kv-benchmark.mjs",
    "bench:flow-query": "node --expose-gc benchmarks/flow-query-benchmark.mjs",
    "bench:dbos": "node benchmarks/dbos-style-benchmark.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@openai/agents": "^0.17.0",
    "@types/node": "^22.20.1",
    "eslint": "^10.9.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.1.48 <2",
    "@langchain/langgraph": ">=1.4.12 <2",
    "@openai/agents": ">=0.17.0 <1"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    }
  }
}
