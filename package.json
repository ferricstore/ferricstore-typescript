{
  "name": "@ferricstore/ferricstore",
  "version": "0.1.6",
  "description": "TypeScript SDK for FerricStore and FerricFlow",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "author": "FerricStore",
  "homepage": "https://github.com/ferricstore/ferricstore-typescript#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferricstore/ferricstore-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/ferricstore/ferricstore-typescript/issues"
  },
  "keywords": [
    "durable-execution",
    "ferricflow",
    "ferricstore",
    "queue",
    "redis",
    "state-machine",
    "workflow"
  ],
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "npm@11.6.2",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:exports && npm run docs:check",
    "docs": "typedoc",
    "docs:check": "typedoc --logLevel Warn",
    "integration:down": "docker compose down -v",
    "integration:up": "docker compose up -d ferricstore && node scripts/wait-for-ferricstore.mjs",
    "lint": "eslint .",
    "pack:dry-run": "npm pack --dry-run",
    "test": "vitest run tests/*.test.ts",
    "test:exports": "node scripts/check-package-exports.mjs",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit",
    "bench:kv": "node benchmarks/kv-benchmark.mjs",
    "bench:dbos": "node benchmarks/dbos-style-benchmark.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.1",
    "@emnapi/runtime": "^1.11.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.0",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
